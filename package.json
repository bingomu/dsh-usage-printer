{
  "name": "@bingomu/dsh-usage-printer",
  "version": "1.0.0",
  "description": "侧栏小票机：点阵数字屏显示余额水位与峰谷，悬停出纸显示明细",
  "type": "module",
  "author": {
    "name": "Genzo",
    "email": "robinham@gmail.com",
    "url": "https://x.com/robinham"
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/bingomu/dsh-usage-printer.git"
  },
  "homepage": "https://github.com/bingomu/dsh-usage-printer#readme",
  "bugs": {
    "url": "https://github.com/bingomu/dsh-usage-printer/issues"
  },
  "publishConfig": {
    "access": "public"
  },
  "engines": {
    "node": ">=22",
    "dsh": ">=0.2.1-rc.5 <0.3.0-0"
  },
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg"
  },
  "files": [
    "index.js",
    "client.js",
    "cordis.patch.yml",
    "locale/*.json",
    "icon.svg",
    "screenshot.png",
    "README.md",
    "LICENSE",
    "CHANGELOG.md"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web"
    },
    "compatibility": {
      "dshReleases": {
        "0.2.1-rc.5": "compatible"
      }
    }
  },
  "keywords": [
    "dsh",
    "deepseek",
    "deepseek-harness",
    "plugin",
    "usage",
    "balance",
    "cost",
    "sidebar",
    "web"
  ]
}
